{
  "name": "handback",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": { "version": "24" }
  },
  "runArgs": ["--memory=16g", "--cpus=8", "--pids-limit=2000", "--security-opt=no-new-privileges", "--cap-drop=ALL"],
  // Every Claude Code session in the container runs the mod straight from the repo and reloads it on save.
  "containerEnv": {
    "CLAUDE_CODE_PLUGIN_DIRS": "${containerWorkspaceFolder}/plugin",
    "CLAUDE_CODE_PLUGIN_DIR_WATCH": "1"
  },
  "postCreateCommand": "npm ci && git config core.hooksPath .githooks",
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  }
}
